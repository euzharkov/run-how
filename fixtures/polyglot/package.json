{ "name": "platform", "private": true, "packageManager": "pnpm@9.0.0",
  "scripts": { "dev": "concurrently -n web,api \"pnpm --filter web dev\" \"dotnet run --project apps/api\"", "test": "pnpm -r test", "lint": "pnpm -r lint", "typecheck": "pnpm -r typecheck", "services": "docker compose -f docker/compose.yml up -d", "kafka:topics": "kafka-topics --bootstrap-server localhost:9092 --list", "kafka:reset": "kafka-topics --bootstrap-server localhost:9092 --delete --topic events", "k8s:render": "kubectl kustomize k8s", "k8s:apply": "kubectl apply -k k8s", "migrate": "dotnet ef database update --project apps/api", "reset": "docker compose -f docker/compose.yml down -v && docker compose -f docker/compose.yml up -d postgres && pnpm migrate" } }
