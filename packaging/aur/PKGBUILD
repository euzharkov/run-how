# AUR sketch for rhow-bin (prebuilt from GitHub Releases).
pkgname=rhow-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Discover how to run and operate any repository"
arch=('x86_64' 'aarch64')
url="https://github.com/euzharkov/run-how"
license=('MIT')
provides=('rhow')
conflicts=('rhow')
source_x86_64=("$url/releases/download/v$pkgver/rhow-$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/rhow-$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('13dcbba369140faad44ec8dd59d2062ba592ccf0943fad1e4e600b56f89b7ff0')
sha256sums_aarch64=('e8de36faf337997cdcb0325f40e6867b3f3ee4ebe213acf3c917b3a9e51b6131')

package() {
  # Name the directory exactly: a glob would also match the downloaded tarball makepkg
  # links into $srcdir. $CARCH is x86_64 or aarch64, matching the release target triples.
  cd "$srcdir/rhow-$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 rhow "$pkgdir/usr/bin/rhow"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
