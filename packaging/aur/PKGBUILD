# AUR sketch for rhow-bin (prebuilt from GitHub Releases).
pkgname=rhow-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Discover how to run and operate any repository"
arch=('x86_64' 'aarch64')
url="https://github.com/line-19/rhow"
license=('MIT')
provides=('rhow')
conflicts=('rhow')
source_x86_64=("$url/releases/download/v$pkgver/rhow-$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/rhow-$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('REPLACE_WITH_SHA256')
sha256sums_aarch64=('REPLACE_WITH_SHA256')

package() {
  cd "rhow-$pkgver-"*
  install -Dm755 rhow "$pkgdir/usr/bin/rhow"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
